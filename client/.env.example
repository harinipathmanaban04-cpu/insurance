# ==============================================================================
# CLIENT ENVIRONMENT VARIABLES (Vite / Vercel)
# ==============================================================================

# API Base URL
# - In local dev with Vite proxy: leave blank to auto-proxy /api -> http://localhost:5000
# - In Vercel deployment: leave blank to auto-route /api to serverless functions
# - For cross-origin backend: e.g. https://api.yourdomain.com
VITE_API_BASE_URL=

# Web3Forms API Access Key for Footer Callback Form (Optional direct client fallback)
VITE_WEB3FORMS_ACCESS_KEY=2741f35b-765b-4bd6-b8aa-0b87a7563f2a
