# ==============================================================================
# THE BEST INSURANCE POINT - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/best_insurance_point?retryWrites=true&w=majority
MONGODB_URI=

# Brevo Transactional Email Service (Official API)
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=bestinsurance.pmk@gmail.com
BREVO_SENDER_NAME=THE BEST INSURANCE POINT
ADMIN_NOTIFICATION_EMAIL=bestinsurance.pmk@gmail.com

# Real Mobile OTP SMS Gateways (Configure one of the following)
# 1. 2Factor.in (Recommended - Instant transactional OTP delivery in India)
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=

# 2. MSG91 (DLT Flow SMS)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# 3. Fast2SMS / Generic SMS Gateway
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=
FAST2SMS_API_KEY=

# Cryptographic Token Signing Secret (Any secure string)
OTP_SECRET=bip_secure_insurance_otp_secret_2026_x87b
