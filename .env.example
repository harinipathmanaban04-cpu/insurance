# ==============================================================================
# THE BEST INSURANCE POINT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Vercel Client)
# ------------------------------------------------------------------------------
# Web3Forms API Access Key for Admin Email Notifications (Optional fallback)
VITE_WEB3FORMS_ACCESS_KEY=2741f35b-765b-4bd6-b8aa-0b87a7563f2a

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SMS OTP CONFIGURATION (Vercel Serverless Functions)
# Keep these in Vercel Project Settings -> Environment Variables.
# Never expose these in frontend code or prefix them with VITE_.
# ------------------------------------------------------------------------------

# Option A: 2Factor.in (Recommended - Instant Indian transactional OTP SMS)
# Get your API key from https://2factor.in
TWOFACTOR_API_KEY=your_2factor_api_key_here
TWOFACTOR_TEMPLATE_NAME=

# Option B: MSG91 (Leading enterprise SMS gateway in India)
# Get your auth key & template from https://msg91.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Option C: Fast2SMS (Alternative Indian SMS gateway)
# Get your API key from https://fast2sms.com
FAST2SMS_API_KEY=

# Server Cryptographic Token Signing Secret
OTP_SECRET=bip_secure_insurance_otp_secret_2026_x87b
